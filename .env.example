# Copia este archivo como .env y completa las credenciales de tu entorno.
PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/cyberfit
SESSION_SECRET=replace_with_a_long_random_secret
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
FRONTEND_ORIGIN=http://localhost:3000
# Si tu configuración usa cifrado TOTP, genera y configura una clave segura.
TOTP_ENCRYPTION_KEY=replace_with_your_totp_encryption_key
